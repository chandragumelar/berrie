{
  "name": "berrie-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build && node scripts/build-app-shell.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "test:access:integration": "vitest run integration/access.test.ts",
    "test:access:e2e": "playwright test -c playwright.access.config.ts",
    "test:pwa:e2e": "playwright test -c playwright.pwa.config.ts",
    "test:pwa:lifecycle": "playwright test -c playwright.pwa.config.ts --grep 'app shell|cache aktif'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
